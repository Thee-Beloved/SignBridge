# Environment Variables — Sign Bridge
# Copy this file to .env and fill in your values

# Meta Model API Key (from dev.meta.ai/events/global-hackathon — you get $150 credits)
META_API_KEY=

# Optional: Baseten / Modal / Fireworks (for extra GPU compute on avatar generation)
BASETEN_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
FIREWORKS_API_KEY=

# Flask
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5000

# File storage
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
FRAMES_CACHE_DIR=frames_cache

# Avatar settings (don't change — locks in consistent avatar)
AVATAR_SEED=47291
AVATAR_SIZE_RATIO=0.28
